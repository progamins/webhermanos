# ══════════════════════════════════════════════════════════════════
# 🌐 MAISON ROSAS — Variables de Entorno para Vercel (plantilla)
# ══════════════════════════════════════════════════════════════════
# ⚠️  SEGURIDAD: Este archivo contenía anteriormente credenciales
#     reales (contraseña de base de datos, contraseñas de roles y
#     ADMIN_SECRET_PATH). Todas fueron reemplazadas por placeholders.
#
#     🔴 ACCIÓN REQUERIDA: Rota TODAS las credenciales que estuvieron
#     expuestas en el historial del repositorio:
#       - Contraseña de la base de datos (Railway/MySQL)
#       - ADMIN_DEFAULT_PASSWORD, ANALYST_DEFAULT_PASSWORD,
#         STOCK_MANAGER_DEFAULT_PASSWORD
#       - ADMIN_SECRET_PATH (y la regla de rewrite correspondiente en
#         vercel.json si se usaba el path anterior)
#
#     Nunca pongas valores reales en un archivo .example versionado.
#     Configúralos desde el dashboard de Vercel:
#       https://vercel.com/progamins/webhermanos-client/settings/environment-variables
#     → Botón "Import from .env" (con tu archivo .env LOCAL).
# ══════════════════════════════════════════════════════════════════

# ============================================
# 🗄️ BASE DE DATOS (MySQL)
# ============================================
DB_HOST="tu-host-mysql.ejemplo.com"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="cambia_esta_password"
DB_NAME="maison_rosas"

# ============================================
# 🔐 CONTRASEÑAS DE ROLES (seed)
# ============================================
# Solo se usan la primera vez al poblar la BD (npm run db:seed).
ADMIN_DEFAULT_PASSWORD="cambia_esta_admin_password"
ANALYST_DEFAULT_PASSWORD="cambia_esta_analyst_password"
STOCK_MANAGER_DEFAULT_PASSWORD="cambia_esta_stock_password"

# ============================================
# 🛡️ RUTA SECRETA DEL PANEL ADMIN
# ============================================
# Cadena aleatoria larga que se concatena a la URL del panel admin.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si usas la ruta en el rewrite de vercel.json, debe coincidir con este valor.
ADMIN_SECRET_PATH="cambia_esta_ruta_secreta_genera_una_aleatoria_larga"

# ============================================
# 🌐 APP URL
# ============================================
APP_URL="https://webhermanos-client.vercel.app"

# ============================================
# 🗂️ VERCEL BLOB (Opcional - para subir imágenes)
# ============================================
# Crea almacenamiento: https://vercel.com/dashboard/stores/blob
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ============================================
# 📧 CORREO (Opcional - Gmail SMTP / Resend)
# ============================================
# SMTP_USER="tu_correo@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# EMAIL_SENDER_NAME="Maison Rosas"
# RESEND_API_KEY="re_xxxx"
# RESEND_SENDER_EMAIL="tu_correo@resend.dev"

# ============================================
# 📊 GOOGLE ANALYTICS 4 (Opcional)
# ============================================
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ============================================
# 🗺️ GOOGLE MAPS (Opcional)
# ============================================
# GOOGLE_MAPS_PLATFORM_KEY="YOUR_API_KEY"

# ============================================
# 🔒 CONTROL DE ACCESO ADMIN (Opcional)
# ============================================
# ALLOWED_ADMIN_IPS="127.0.0.1,::1"
# ALLOWED_MAC_ADDRESSES=""
