# ══════════════════════════════════════════════════════════════════
# 🌐 MAISON ROSAS — Variables de Entorno para Vercel
# ══════════════════════════════════════════════════════════════════
# Copia este archivo y configura cada variable en:
#   https://vercel.com/[tu-usuario]/maison-rosas/settings/environment
#
# O desde la CLI:
#   vercel env add NOMBRE_VARIABLE
# ══════════════════════════════════════════════════════════════════

# ============================================
# 🗄️ BASE DE DATOS (MySQL Externo)
# ============================================
# ⚠️ OBLIGATORIO: Vercel NO tiene MySQL. Necesitas hostearlo externamente.
# Opciones recomendadas:
#   - PlanetScale  → https://planetscale.com  (serverless MySQL, plan gratuito)
#   - Railway      → https://railway.app      (MySQL fácil, plan gratuito)
#   - Aiven        → https://aiven.io         (MySQL gestionado)
#   - Clever Cloud → https://clever-cloud.com (MySQL 5MB gratis)
DB_HOST="aws.connect.psdb.cloud"     # Ejemplo PlanetScale
DB_PORT=3306
DB_USER="xxxxxxxxxxxx"               # Usuario de la BD
DB_PASSWORD="pscale_pw_xxxxx"        # Contraseña de la BD
DB_NAME="maison_rosas"               # Nombre de la base de datos

# ============================================
# 🔐 CONTRASEÑAS DE ROLES (seed)
# ============================================
# ⚠️ OBLIGATORIO: Usadas la primera vez que se popula la BD
ADMIN_DEFAULT_PASSWORD="admin_segura_123"
ANALYST_DEFAULT_PASSWORD="analyst_segura_123"
STOCK_MANAGER_DEFAULT_PASSWORD="stock_segura_123"

# ============================================
# 🛡️ RUTA SECRETA DEL PANEL ADMIN
# ============================================
# ⚠️ OBLIGATORIO: Cadena aleatoria larga para proteger el admin
ADMIN_SECRET_PATH="admin-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# 🗂️ VERCEL BLOB (Archivos subidos)
# ============================================
# ⚠️ OBLIGATORIO si usas carga de archivos (imágenes, vouchers)
# Crea un almacenamiento Blob desde:
#   https://vercel.com/dashboard/stores/blob
# Luego copia el token de lectura/escritura
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ============================================
# 🌐 APP URL
# ============================================
# La URL de tu dominio en Vercel (sin barra al final)
APP_URL="https://maison-rosas.vercel.app"

# ============================================
# 📧 CORREO (Gmail SMTP o Resend)
# ============================================
# Opción A: Gmail SMTP (gratuito)
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"      # Contraseña de aplicación de Google
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_SENDER_NAME="Maison Rosas"

# Opción B: Resend API (alternativa)
# RESEND_API_KEY="re_xxxx"
# RESEND_SENDER_EMAIL="tu_correo@resend.dev"

# ============================================
# 📊 GOOGLE ANALYTICS 4 (opcional)
# ============================================
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ============================================
# 🗺️ GOOGLE MAPS (opcional)
# ============================================
GOOGLE_MAPS_PLATFORM_KEY="YOUR_API_KEY"

# ============================================
# 🔒 CONTROL DE ACCESO ADMIN (opcional)
# ============================================
# Lista de IPs separadas por coma para restringir acceso admin
# ALLOWED_ADMIN_IPS="127.0.0.1,::1"
# Lista de MACs separadas por coma
# ALLOWED_MAC_ADDRESSES=""

# ============================================
# ⚙️ RATE LIMITING (opcional)
# ============================================
# Límite de solicitudes por minuto para API general
# API_RATE_LIMIT=60
# Límite de solicitudes por minuto para rutas admin
# ADMIN_RATE_LIMIT=30
