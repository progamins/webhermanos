{
  "name": "maison-rosas",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "clean": "rm -rf dist node_modules client/node_modules server/node_modules",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:pre": "node scripts/version.mjs prerelease alpha",
    "version:show": "node scripts/version.mjs show",
    "version:dryrun": "node scripts/version.mjs patch --dry-run",
    "version:tag": "node scripts/version.mjs patch --tag",
    "version:release": "node scripts/version.mjs patch --release",
    "version:release:minor": "node scripts/version.mjs minor --release",
    "version:release:major": "node scripts/version.mjs major --release",

    "vercel:build": "npm run build --workspace=client",
    "vercel:dev": "npm run dev --workspace=client"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
